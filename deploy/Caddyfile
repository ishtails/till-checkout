# HTTPS for the live demo. The pay app is static files; the server and shop run under systemd.
pay.till.ishtails.xyz, pay.2-31-114-247.sslip.io {
	root * /home/till/till/apps/pay/dist
	try_files {path} /index.html
	file_server
}

api.till.ishtails.xyz, api.2-31-114-247.sslip.io {
	reverse_proxy localhost:3001
}

till.ishtails.xyz, shop.2-31-114-247.sslip.io {
	reverse_proxy localhost:3002
}
