# Copy to .env (git-ignored). Never commit real keys.

# Whitechain Sepolia (chain 1874)
WHITECHAIN_RPC_URL=https://rpc.testnet.whitechain.io
USDT_ADDRESS=0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7
CHECKOUT_CONTRACT=
DEPLOYER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=

# Hedera testnet: our facilitator's fee payer account (ECDSA key), which pays the network fee
HEDERA_FEE_PAYER_ID=
HEDERA_FEE_PAYER_KEY=

# Server
MERCHANTS_FILE=merchants.json
STORE_FILE=data/store.json

# Test customer for scripts (pre-funded with test USDT, holds no WBT)
CUSTOMER_PRIVATE_KEY=

# Pay app (Vite reads these from the repo root)
VITE_PRIVY_APP_ID=
VITE_API_URL=http://localhost:3001

# Demo shop (the values from merchants.json)
CHECKOUT_API_KEY=
CHECKOUT_WEBHOOK_SECRET=

# Agent
AGENT_EVM_KEY=
# The agent's Hedera account (holds testnet USDC; must have signed one transaction before)
AGENT_HEDERA_ID=
AGENT_HEDERA_KEY=
# The agent's public spending log (an HCS topic whose submit key is the agent's key)
HCS_TOPIC_ID=
# Which network the agent pays on: hedera:testnet or eip155:1874
NETWORK=hedera:testnet

# Attacker (demo): any addresses, never paid
ATTACKER_EVM=0x7854711f971b3183Ed52BeaA28f62c2d2582FA80
ATTACKER_HEDERA=0.0.6660666

# Arkiv (Rabdi testnet): the key that writes receipt records. Optional; fund it with GLM from hub.arkiv.network/faucet
ARKIV_PRIVATE_KEY=
# Free key from hub.arkiv.network/access-keys (not a secret; restrict it to your origins). Empty uses the rate-limited public RPC
ARKIV_ACCESS_KEY=
VITE_ARKIV_ACCESS_KEY=
